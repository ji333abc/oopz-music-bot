# ---------- QQ 官方机器人（必填） ----------
QQBOT_APP_ID=
QQBOT_APP_SECRET=

# 由 `oopzbot init` 自动生成。不要手动复用其他服务的 Token。
QQBOT_BRIDGE_TOKEN=
QQBOT_ALLOWED_GROUP_OPENIDS=
# 桥接命令超过此秒数时转入后台等待；期间不发占位消息，只发送最终结果。
QQBOT_COMMAND_DEFER_SECONDS=2.5

# ---------- OOPZ 登录（二选一） ----------
# 推荐：账号密码登录，SDK 会负责获取和刷新凭据。
OOPZ_LOGIN_METHOD=auto
OOPZ_LOGIN_PHONE=
OOPZ_LOGIN_PASSWORD=

# 或使用已有凭据；使用此方式时三个值必须同时填写。
OOPZ_DEVICE_ID=
OOPZ_PERSON_UID=
OOPZ_JWT_TOKEN=

# ---------- OOPZ 目标频道（必填） ----------
QQBOT_OOPZ_AREA_ID=
QQBOT_OOPZ_TEXT_CHANNEL_ID=
QQBOT_OOPZ_VOICE_CHANNEL_ID=

# 旧版 OOPZ Agora 语音核心需要；从旧 config.py 的 agora_app_id 迁移。
OOPZ_AGORA_APP_ID=
OOPZBOT_USE_LEGACY_CORE=true
OOPZ_LEGACY_WEB_BIND=127.0.0.1
OOPZ_LEGACY_WEB_PORT=18081

# Docker 镜像使用系统 Chromium；本地安装通常保持为空。
OOPZ_VOICE_BROWSER_EXECUTABLE_PATH=

# ---------- QQ 音乐接口 ----------
QQ_MUSIC_ENABLED=true
QQ_MUSIC_MANAGED=true
QQ_MUSIC_BASE_URL=http://127.0.0.1:3200
QQ_MUSIC_SERVICE_DIR=.services/qqmusic-api
QQ_MUSIC_COOKIE=
QQ_MUSIC_QUALITY=320
QQ_MUSIC_FALLBACK_QUALITY=128

# ---------- 内部服务 ----------
# 为安全起见只允许回环地址。无需向公网开放端口。
OOPZBOT_BRIDGE_HOST=127.0.0.1
OOPZBOT_BRIDGE_PORT=18080
# 仅 Compose 会覆盖并启用；普通宿主机部署请保持 false。
OOPZBOT_BRIDGE_PRIVATE_NETWORK=false
LOG_LEVEL=INFO

# ---------- 可选 Web 面板 ----------
# 默认只监听本机；面板自身使用 HTTP Basic Auth，密码为必填项。
OOPZ_PANEL_BIND=127.0.0.1
OOPZ_PANEL_PORT=3000
OOPZ_PANEL_PUBLIC_URL=http://localhost:3000
OOPZ_PANEL_USERNAME=admin
OOPZ_PANEL_PASSWORD=
RACKNERD_API_KEY=
RACKNERD_API_HASH=

# ---------- 可选 JM 后台任务 ----------
QQBOT_JM_ENABLED=false
QQBOT_JM_ALLOWED_USER_OPENIDS=
QQBOT_JM_MAX_BYTES=83886080
QQBOT_JM_TIMEOUT_SECONDS=1200
QQBOT_JM_UPLOAD_TIMEOUT_SECONDS=900
QQBOT_JM_FAILURE_RETAIN_SECONDS=1800
QQBOT_JM_INSPECT_TIMEOUT_SECONDS=30
QQBOT_JM_BATCH_MAX_ITEMS=3
