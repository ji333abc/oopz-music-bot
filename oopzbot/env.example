# ---------- QQ 官方机器人（必填） ----------
QQBOT_APP_ID=
QQBOT_APP_SECRET=

# 由 `oopzbot init` 自动生成。不要手动复用其他服务的 Token。
QQBOT_BRIDGE_TOKEN=
QQBOT_ALLOWED_GROUP_OPENIDS=
# 桥接命令超过此秒数时转入后台等待；期间不发占位消息，只发送最终结果。
QQBOT_COMMAND_DEFER_SECONDS=2.5

# ---------- OOPZ 登录（二选一） ----------
# 推荐：账号密码登录，SDK 会负责获取和刷新凭据。
OOPZ_LOGIN_METHOD=auto
OOPZ_LOGIN_PHONE=
OOPZ_LOGIN_PASSWORD=

# 或使用已有凭据；使用此方式时三个值必须同时填写。
OOPZ_DEVICE_ID=
OOPZ_PERSON_UID=
OOPZ_JWT_TOKEN=

# ---------- OOPZ 目标频道（必填） ----------
QQBOT_OOPZ_AREA_ID=
QQBOT_OOPZ_TEXT_CHANNEL_ID=
QQBOT_OOPZ_VOICE_CHANNEL_ID=

# 旧版 OOPZ Agora 语音核心需要；从旧 config.py 的 agora_app_id 迁移。
OOPZ_AGORA_APP_ID=
OOPZBOT_USE_LEGACY_CORE=true
OOPZ_LEGACY_WEB_BIND=127.0.0.1
OOPZ_LEGACY_WEB_PORT=18081
# 可选：供本机 Nginx 访问 status/queue/lyric，只使用独立随机值，不要复用播放器 Cookie。
OOPZ_READONLY_API_TOKEN=

# Docker 镜像使用系统 Chromium；本地安装通常保持为空。
OOPZ_VOICE_BROWSER_EXECUTABLE_PATH=

# ---------- QQ 音乐接口 ----------
QQ_MUSIC_ENABLED=true
QQ_MUSIC_MANAGED=true
QQ_MUSIC_BASE_URL=http://127.0.0.1:3200
QQ_MUSIC_SERVICE_DIR=.services/qqmusic-api
QQ_MUSIC_COOKIE=
# 扫码凭证的唯一事实源。首次登录：oopzbot qqmusic-login login
QQ_MUSIC_CREDENTIAL_FILE=data/qqmusic-credential.json
QQ_MUSIC_AUTO_REFRESH=true
QQ_MUSIC_REFRESH_MIN_HOURS=6
QQ_MUSIC_REFRESH_MAX_HOURS=24
# Compose 已自动配置为 http://qqmusic:3201；本地托管可留空。
QQ_MUSIC_COOKIE_API_URL=
QQ_MUSIC_QUALITY=320
QQ_MUSIC_FALLBACK_QUALITY=128

# P2 有界搜索缓存；只缓存搜索展示结果，不缓存播放 URL 或认证错误。
OOPZ_SEARCH_CACHE_ENABLED=true
OOPZ_SEARCH_CACHE_TTL_SECONDS=60
OOPZ_SEARCH_CACHE_MAX_ENTRIES=256
OOPZ_ALBUM_REQUEST_ENABLED=false
OOPZ_ALBUM_REQUEST_MAX_TRACKS=30
OOPZ_ALBUM_REQUEST_SESSION_TTL_SECONDS=300
OOPZ_SEARCH_NEGATIVE_CACHE_TTL_SECONDS=10
OOPZ_METRICS_WINDOW_SIZE=200
OOPZ_PLAYBACK_HISTORY_LIMIT=50
OOPZ_FAILURE_HISTORY_LIMIT=100
OOPZ_COMMAND_HISTORY_LIMIT=200

# ---------- 内部服务 ----------
# 为安全起见只允许回环地址。无需向公网开放端口。
OOPZBOT_BRIDGE_HOST=127.0.0.1
OOPZBOT_BRIDGE_PORT=18080
# 仅 Compose 会覆盖并启用；普通宿主机部署请保持 false。
OOPZBOT_BRIDGE_PRIVATE_NETWORK=false
LOG_LEVEL=INFO

# ---------- 可选 Web 面板 ----------
# 默认只监听本机；面板自身使用 HTTP Basic Auth，密码为必填项。
OOPZ_PANEL_BIND=127.0.0.1
OOPZ_PANEL_PORT=3000
OOPZ_PANEL_PUBLIC_URL=http://localhost:3000
OOPZ_PANEL_USERNAME=admin
OOPZ_PANEL_PASSWORD=
RACKNERD_API_KEY=
RACKNERD_API_HASH=
OOPZ_PANEL_SSE_ENABLED=true
OOPZ_PANEL_SSE_HEARTBEAT_SECONDS=20
OOPZ_PANEL_SSE_FALLBACK_POLL_SECONDS=60

# ---------- 可选 JM 后台任务 ----------
QQBOT_JM_ENABLED=false
QQBOT_JM_ALLOWED_USER_OPENIDS=
QQBOT_JM_MAX_BYTES=83886080
QQBOT_JM_TIMEOUT_SECONDS=1200
QQBOT_JM_UPLOAD_TIMEOUT_SECONDS=900
QQBOT_JM_BATCH_MAX_ITEMS=3
