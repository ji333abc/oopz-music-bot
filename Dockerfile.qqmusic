FROM node:22-alpine AS build

WORKDIR /opt/qqmusic-api
RUN npm init -y >/dev/null 2>&1 \
    && npm install --omit=dev --no-audit --no-fund @sansenjian/qq-music-api@2.4.0

FROM node:22-alpine

LABEL org.opencontainers.image.source="https://github.com/sansenjian/qq-music-api" \
      org.opencontainers.image.version="2.4.0" \
      org.opencontainers.image.licenses="MIT"

WORKDIR /opt/qqmusic-api
COPY --from=build /opt/qqmusic-api ./
COPY oopzbot/qqmusic_launcher.cjs /opt/oopzbot/qqmusic_launcher.cjs

ENV PORT=3200 \
    QQ_MUSIC_HOST=0.0.0.0 \
    QQ_MUSIC_API_CONFIG_DIR=/opt/qqmusic-config

EXPOSE 3200
CMD ["node", "/opt/oopzbot/qqmusic_launcher.cjs", "/opt/qqmusic-api"]
